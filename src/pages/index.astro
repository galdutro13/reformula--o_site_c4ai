---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath } from '../i18n/routes';
---

<BaseLayout
  locale="pt"
  title="C4AI | Português / English"
  description="Escolha o idioma do site do C4AI. Choose the language of the C4AI website."
>
  <section class="hero" aria-labelledby="page-title">
    <p class="eyebrow">C4AI</p>
    <h1 id="page-title">
      Escolha seu idioma
      <span class="heading-translation" lang="en">
        Choose your language
      </span>
    </h1>
    <p class="lead">
      Estrutura demonstrativa do novo site.{' '}
      <span lang="en">A demonstration of the new website.</span>
    </p>
    <div class="language-choices">
      <a class="button-link" href={pagePath('home', 'pt')} lang="pt-BR">
        Continuar em português
      </a>
      <a class="button-link secondary" href={pagePath('home', 'en')} lang="en">
        Continue in English
      </a>
    </div>
  </section>
</BaseLayout>
