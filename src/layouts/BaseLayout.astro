---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  routes,
  withBase,
  type PageId,
  type Translations,
} from '../i18n/routes';
import { ui, locales, type Locale } from '../i18n/ui';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  pageId?: PageId;
  notFound?: boolean;
  path?: string;
  translations?: Translations;
}
const {
  locale,
  title,
  description,
  pageId,
  notFound = false,
  path,
} = Astro.props;
const translations = Astro.props.translations ?? routes[pageId ?? 'home'];
const canonical = withBase(path ?? (pageId ? routes[pageId][locale] : '/'));
const paired = Boolean(translations.pt && translations.en);
---

<!doctype html>
<html lang={ui[locale].lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {(!import.meta.env.PUBLIC_INDEXABLE || notFound) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    {!notFound && (
      <link rel="canonical" href={new URL(canonical, Astro.site)} />
    )}
    {!notFound && paired && (
      <>
        {locales.map((lang) => (
          <link
            rel="alternate"
            hreflang={ui[lang].lang}
            href={new URL(withBase(translations[lang]!), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(withBase('/'), Astro.site)}
        />
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui[locale].skip}
    </a>
    <Header
      locale={locale}
      translations={translations}
      currentPath={canonical}
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
