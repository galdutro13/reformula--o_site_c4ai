---
import { withBase } from '../i18n/routes';
import type { Locale } from '../i18n/ui';
import { labels } from '../i18n/navigation';
import marks from '../data/marks.json';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = labels[locale];
const social = [
  ['YouTube', 'https://www.youtube.com/c/C4AIUSP'],
  ['Instagram', 'https://www.instagram.com/c4aiusp/'],
  ['Facebook', 'https://www.facebook.com/groups/C4AI.USP'],
  ['LinkedIn', 'https://bit.ly/C4AI-Linkedin'],
  ['Flickr', 'https://www.flickr.com/photos/195298871@N06/albums'],
  ['Linktree', 'https://linktr.ee/c4aiusp'],
];
---

<footer class="site-footer container">
  <p>{t.hosted}</p>
  <div class="host-marks">
    <a href={`https://ciaam.usp.br/${locale}/`}>
      <img
        src={withBase(marks.ciaam)}
        alt="CIAAM"
        width="1648"
        height="646"
        loading="lazy"
      />
    </a>
    <a href="https://www.usp.br/">
      <img
        src={withBase(marks.usp)}
        alt="USP"
        width="230"
        height="100"
        loading="lazy"
      />
    </a>
  </div>
  <div class="footer-bottom">
    <nav aria-label={locale === 'pt' ? 'Redes sociais' : 'Social media'}>
      <ul>
        {social.map(([name, href]) => (
          <li>
            <a href={href}>
              {name}
              <span class="sr-only"> ({t.external})</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p>
      ©{' '}
      {locale === 'pt'
        ? 'Centro de Inteligência Artificial'
        : 'Center for Artificial Intelligence'}{' '}
      2020 – 2024
    </p>
  </div>
</footer>
