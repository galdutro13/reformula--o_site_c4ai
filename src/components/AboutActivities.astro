---
import { aboutIntroContent } from '../content/about-intro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = aboutIntroContent[locale];
---

<section
  class="about-activities"
  id="Overlappable"
  aria-labelledby="about-activities-title"
>
  <h2 id="about-activities-title">{copy.activitiesTitle}</h2>
  <div class="about-activity-cards">
    {copy.activities.map((activity) => (
      <article
        class="about-activity-card"
        aria-labelledby={`about-${activity.id}-title`}
      >
        <span class="about-activity-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="28"
            height="28"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            {activity.id === 'video' ? (
              <>
                <rect x="2" y="4" width="20" height="16" rx="4" />
                <path d="m10 8 6 4-6 4Z" fill="currentColor" stroke="none" />
              </>
            ) : (
              <>
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8" cy="8" r="1.5" />
                <path d="m3 17 5-5 4 4 3-3 6 6" />
              </>
            )}
          </svg>
        </span>
        <div class="about-activity-copy">
          <h3 id={`about-${activity.id}-title`}>{activity.title}</h3>
          <p>{activity.description}</p>
        </div>
        <a class="about-activity-link" href={activity.href}>
          <span>{activity.action}</span>
          <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </div>
</section>
