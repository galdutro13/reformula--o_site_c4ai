---
import { contentUrl, pagePath, type Translations } from '../i18n/routes';
import { ui, type Locale } from '../i18n/ui';
import { labels } from '../i18n/navigation';
interface Props {
  locale: Locale;
  translations: Translations;
}
const { locale, translations } = Astro.props;
const missing = !translations[locale === 'pt' ? 'en' : 'pt'];
---

<nav aria-label={ui[locale].languages} class="language-switcher">
  {(['pt', 'en'] as const)
    .filter((lang) => translations[lang])
    .map((lang) => (
      <a
        href={contentUrl(translations[lang]!)}
        lang={lang === 'pt' ? 'pt-BR' : 'en'}
        hreflang={lang === 'pt' ? 'pt-BR' : 'en'}
        aria-current={locale === lang ? 'page' : undefined}
      >
        {lang === 'pt' ? 'Português' : 'English'}
      </a>
    ))}
  {missing && (
    <span class="translation-missing">
      {labels[locale].missing}{' '}
      <a href={pagePath('news', locale === 'pt' ? 'en' : 'pt')}>
        {labels[locale].otherNews}
      </a>
    </span>
  )}
</nav>
