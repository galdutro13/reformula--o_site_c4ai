---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { pagePath, type PageId } from '../i18n/routes';
import { ui, type Locale } from '../i18n/ui';
interface Props {
  locale: Locale;
  pageId?: PageId;
}
const { locale, pageId } = Astro.props;
---

<header class="site-header container">
  <a
    class="wordmark"
    href={pagePath('home', locale)}
    aria-label={`C4AI — ${ui[locale].home}`}
  >
    C4AI<span aria-hidden="true">.</span>
  </a>
  <LanguageSwitcher locale={locale} pageId={pageId} />
</header>
