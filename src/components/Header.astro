---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Navigation from './Navigation.astro';
import { pagePath, withBase, type Translations } from '../i18n/routes';
import type { Locale } from '../i18n/ui';
import { labels } from '../i18n/navigation';
import marks from '../data/marks.json';
interface Props {
  locale: Locale;
  translations: Translations;
  currentPath: string;
}
const { locale, translations, currentPath } = Astro.props;
---

<header class="site-header">
  <div class="header-main container">
    <a
      class="wordmark"
      href={pagePath('home', locale)}
      aria-label={`C4AI — ${labels[locale].home}`}
    >
      <img
        src={withBase(marks.logo)}
        width="181"
        height="72"
        alt="Center for Artificial Intelligence"
      />
    </a>
    <nav
      class="desktop-navigation"
      aria-label={locale === 'pt' ? 'Principal' : 'Main'}
    >
      <Navigation
        locale={locale}
        currentPath={currentPath}
        group="desktop-header"
      />
    </nav>
    <div class="desktop-language">
      <LanguageSwitcher locale={locale} translations={translations} />
    </div>
    <details class="mobile-navigation">
      <summary>
        <span class="mobile-menu-button">
          <span class="menu-label-closed">{labels[locale].menu}</span>
          <span class="menu-label-open">{labels[locale].closeMenu}</span>
          <span class="menu-label-closed" aria-hidden="true">
            ☰
          </span>
          <span class="menu-label-open" aria-hidden="true">
            ×
          </span>
        </span>
      </summary>
      <div class="mobile-navigation-panel">
        <nav aria-label={locale === 'pt' ? 'Principal móvel' : 'Mobile main'}>
          <Navigation
            locale={locale}
            currentPath={currentPath}
            group="mobile-header"
          />
        </nav>
        <div class="mobile-language">
          <LanguageSwitcher locale={locale} translations={translations} />
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  import '../navigation/header';
</script>
